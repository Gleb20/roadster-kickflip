{
  "name": "roadster-kickflip",
  "version": "4.6.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs && npm run check:content && npm run check:types && npm run check:pwa",
    "check:content": "node scripts/check-content.mjs",
    "check:types": "tsc --noEmit",
    "build:pwa": "node scripts/build-pwa.mjs",
    "check:pwa": "node scripts/build-pwa.mjs --check",
    "build:ranking": "esbuild supabase/entry.mjs --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/tesla-ranking/index.ts && esbuild supabase/worker-entry.mjs --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/tesla-ranking-worker/index.ts"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
